# PaperBroker environment — copy to your own .env (gitignored); never commit real values.

PB_SESSION_SECRET=            # openssl rand -hex 32
PB_DB_PATH=                   # default: data/paperbroker.db
PB_STARTING_CASH=100000
PB_ADMIN_EMAILS=              # comma-separated; seeded on the EC2 box only
PB_ADMIN_PASSWORD=
